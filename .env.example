# DataLab Dashboard configuration.
# Copy to ".env" and adjust as needed. All values have sensible defaults,
# so the dashboard runs out of the box with an empty or missing .env.

# --- Server ---
PORT=3000
TZ_NAME=America/Los_Angeles

# --- Projects (Google Sheet, published/link-viewable CSV) ---
PROJECTS_CSV_URL=https://docs.google.com/spreadsheets/d/1XdF1epRZ9bVu8WYqGl3qZxPNS8Hnl1bk-RCAVCKYmFE/gviz/tq?tqx=out:csv&gid=0
# Comma-separated Status values (case-insensitive) treated as "active" for the spotlight.
PROJECTS_ACTIVE_STATUSES=active
# Comma-separated Status values shown in the completed-projects marquee.
PROJECTS_COMPLETED_STATUSES=completed
PROJECTS_REFRESH_MS=43200000

# --- Workshops (Localist JSON API) ---
WORKSHOPS_API_URL=https://events.library.ucdavis.edu/api/2/events
# Optional Localist numeric group id and/or keyword to narrow to DataLab events.
# Leave blank to pull the whole library calendar. Fill GROUP_ID once known.
WORKSHOPS_GROUP_ID=
WORKSHOPS_KEYWORD=
WORKSHOPS_DAYS_AHEAD=120
WORKSHOPS_MAX=5
WORKSHOPS_REFRESH_MS=43200000

# --- Shields Library hours (LibCal / Springshare) ---
HOURS_GRID_URL=https://reservations.library.ucdavis.edu/api_hours_grid.php
HOURS_LID=18170
HOURS_LOCATION_NAME=Shields Library
# Minutes-before-close at which to warn (each fires a chime once/day). Descending.
HOURS_WARN_MINUTES=15,5
HOURS_REFRESH_MS=900000
HOURS_REFRESH_MS_NEAR_CLOSE=30000
HOURS_NEAR_CLOSE_WINDOW_MIN=30

# --- UI ---
UI_PROJECT_ROTATE_SEC=12
UI_POLL_MS=45000
